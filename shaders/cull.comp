#version 460 core

//Occlusion culling algorithm and getBoxCorner credit: nVidia gl_occlusion_culling sample

#include "shared/binding_points.glsl"
#include "shared/samplers.glsl"
#include "shared/types.glsl"
#include "shared/ubo.glsl"

// Attributes
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Constants
const int minScreenSize = 4;
const int maxMipTexels = 8;

// SSBOs
layout(binding = SSBO_BINDING_VISIBILITY_MAP, std430) restrict readonly buffer mapSSBO
{
    BufferMap maps[];
};

layout(binding = SSBO_BINDING_AABB, std430) restrict readonly buffer aabbSSBO
{
    AABB AABBs[];
};

layout(binding = SSBO_BINDING_MATRICES, std430) restrict readonly buffer matricesSSBO
{
    mat4 matrices[];
};

layout(binding = SSBO_BINDING_CULL_RESULTS, std430) buffer cullResultsSSBO
{
    uint cullResults[];
};

layout(binding = SSBO_BINDING_VISIBLE_INSTANCES, std430) restrict writeonly buffer visibleInstancesSSBO
{
    uint visibleInstances[];
};

bool aabbIntersectsFrustum(vec3 worldCenter, vec3 worldExtent)
{
    for (int i = 0; i < 6; ++i)
    {
        float d = dot(worldCenter, planes[i].xyz);
        float r = dot(worldExtent, abs(planes[i].xyz));

        if (d + r < -planes[i].w)
            return false;
    }

    return true;
}

vec4 getBoxCorner(vec4 bboxMin, vec4 bboxMax, int n)
{
    bvec3 useMax = bvec3((n & 1) != 0, (n & 2) != 0, (n & 4) != 0);
    return vec4(mix(bboxMin.xyz, bboxMax.xyz, useMax), 1);
}

// In
uniform ivec2 renderResolution;
uniform ivec2 hiZResolution;
uniform int hiZMaxMip;
uniform float nearPlane;

void main()
{
    uint instance = gl_GlobalInvocationID.x;

    if (instance >= maps.length())
        return;
    
    mat4 modelMatrix = matrices[instance];
    BufferMap map = maps[instance];
    
    AABB aabb = AABBs[map.sharedBaseIndex];
    uint visibilityBufferBaseIndex = map.visibleInstancesBaseIndex;

    // World space AABB
    mat3 RS = mat3(modelMatrix);
    mat3 absRS = mat3(abs(RS[0]), abs(RS[1]), abs(RS[2]));

    vec3 worldCenter = vec3(modelMatrix * vec4(aabb.center.xyz, 1.0));
    vec3 worldExtent =  absRS * aabb.extent.xyz;

    if (!aabbIntersectsFrustum(worldCenter, worldExtent))
        return;

    vec4 aabbMin = aabb.center - aabb.extent;
    vec4 aabbMax = aabb.center + aabb.extent;
    mat4 mvp = viewProjectionMatrix * modelMatrix;
    vec3 clipMin = vec3(1e30);
    vec3 clipMax = vec3(-1e30);
    bool isNear = false;

    for (int i = 0; i < 8; ++i)
    {
        vec4 clipPos = mvp * getBoxCorner(aabbMin, aabbMax, i);

        if (clipPos.w <= 0.0)
        {
            isNear = true;
            break;
        }

        vec3 ndcPos = clipPos.xyz / clipPos.w;
        clipMin = min(clipMin, ndcPos);
        clipMax = max(clipMax, ndcPos);
    }
    
    if (isNear)
    {
        uint counter = atomicAdd(cullResults[map.sharedBaseIndex], 1);
        visibleInstances[visibilityBufferBaseIndex + counter] = instance;  
        return;
    }

    // Reusing clip in UV space to keep register pressure down
    clipMin = clamp(clipMin * 0.5 + 0.5, 0.0, 1.0);
    clipMax = clamp(clipMax * 0.5 + 0.5, 0.0, 1.0);

    ivec2 screenSize = ivec2(vec2(clipMax - clipMin) * vec2(renderResolution));
    
    if (max(screenSize.x, screenSize.y) < minScreenSize)
        return;
    
    vec2 mipResolution = (clipMax.xy - clipMin.xy) * hiZResolution; 
    float mipLevel = ceil(log2(max(mipResolution.x, mipResolution.y)));
    mipLevel = clamp(mipLevel, 0.0, float(hiZMaxMip));

    float depth = 0.0;
    float a = textureLod(hiZ, clipMin.xy, mipLevel).r;
    float b = textureLod(hiZ, vec2(clipMax.x, clipMin.y), mipLevel).r;
    float c = textureLod(hiZ, clipMax.xy, mipLevel).r;
    float d = textureLod(hiZ, vec2(clipMin.x,clipMax.y), mipLevel).r;
    depth = max(depth, max(max(max(a,b), c), d));

    if (clipMin.z > depth)
        return;

    uint counter = atomicAdd(cullResults[map.sharedBaseIndex], 1);
    visibleInstances[visibilityBufferBaseIndex + counter] = instance;      
}