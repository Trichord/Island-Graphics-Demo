#version 460 core

#include "shared/binding_points.glsl"
#include "shared/types.glsl"

// Attributes
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SSBOs
layout(binding = SSBO_BINDING_VISIBILITY_MAP, std430) restrict readonly buffer mapSSBO
{
    BufferMap maps[];
};

layout(binding = SSBO_BINDING_METADATA, std430) restrict readonly buffer metadataSSBO
{
    Metadata metadata[];
};

layout(binding = SSBO_BINDING_DRAW_COUNTS, std430) buffer drawCountsSSBO
{
    uint drawCounts[];
};

layout(binding = SSBO_BINDING_CULL_RESULTS, std430) restrict readonly buffer cullResultsSSBO
{
    uint cullResults[];
};

layout(binding = SSBO_BINDING_DRAW_COMMANDS, std430) restrict writeonly buffer drawCommandsSSBO
{
    DrawElementsIndirectCommand commandsDestination[];
};

layout(binding = SSBO_BINDING_DRAW_COMMANDS_SOURCE, std430) restrict readonly buffer drawCommandsSourceSSBO
{
    DrawElementsIndirectCommand commandsSource[];
};

void main()
{
    if (gl_GlobalInvocationID.x >= commandsSource.length())
        return;

    uint cullResult = cullResults[gl_GlobalInvocationID.x];

    if (cullResult == 0)
        return;

    uint mapIndex = metadata[gl_GlobalInvocationID.x].visibleInstancesBaseIndex;
    BufferMap map = maps[mapIndex];

    // Use the MDI drawcount as a write index. As we write draw commands, the final number for the draw call
    // increases, so we can take advantage of that as our new offset
    uint writeOffset = atomicAdd(drawCounts[map.drawBucket], 1);
    uint writeIndex = map.drawCommandsBaseIndex + writeOffset;

    commandsDestination[writeIndex] = commandsSource[gl_GlobalInvocationID.x];
    commandsDestination[writeIndex].instanceCount = cullResult;
}