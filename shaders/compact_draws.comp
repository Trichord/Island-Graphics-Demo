#version 460 core

#include "shared/binding_points.glsl"
#include "shared/types.glsl"

// Attributes
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SSBOs
layout(binding = SSBO_BINDING_DRAW_COUNTS, std430) buffer drawCountsSSBO
{
    uint drawCounts[];
};

layout(binding = SSBO_BINDING_CULL_RESULTS, std430) restrict readonly buffer cullResultsSSBO
{
    uint cullResults[];
};

layout(binding = SSBO_BINDING_DRAW_COMMANDS, std430) restrict writeonly buffer drawCommandsSSBO
{
    DrawElementsIndirectCommand commandsDestination[];
};

layout(binding = SSBO_BINDING_DRAW_COMMANDS_SOURCE, std430) restrict readonly buffer drawCommandsSourceSSBO
{
    SourceDrawElementsIndirectCommand commandsSource[];
};

void main()
{
    uint sharedIndex = gl_GlobalInvocationID.x;

    if (sharedIndex >= commandsSource.length())
        return;

    uint cullResult = cullResults[sharedIndex];

    if (cullResult == 0)
        return;
    
    SourceDrawElementsIndirectCommand srcCmd = commandsSource[sharedIndex];

    // Use the MDI drawcount as a write index. As we write draw commands, the final number for the draw call
    // increases, so we can take advantage of that as our new offset
    uint writeOffset = atomicAdd(drawCounts[srcCmd.drawBucket], 1);
    uint writeIndex = srcCmd.drawCommandsBaseIndex + writeOffset;

    commandsDestination[writeIndex] = DrawElementsIndirectCommand(srcCmd.count, cullResult, srcCmd.firstIndex, srcCmd.baseVertex, srcCmd.baseInstance);
}