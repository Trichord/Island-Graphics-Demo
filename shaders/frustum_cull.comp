#version 460 core

#include "binding_points.glsl"
#include "types.glsl"
#include "ubo.glsl"

// Attributes
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SSBOs
layout(binding = SSBO_BINDING_VISIBILITY_MAP, std430) restrict readonly buffer mapSSBO
{
    BufferMap maps[];
};

layout(binding = SSBO_BINDING_AABB, std430) restrict readonly buffer aabbSSBO
{
    AABB AABBs[];
};

layout(binding = SSBO_BINDING_MATRICES, std430) restrict readonly buffer matricesSSBO
{
    mat4 matrices[];
};

layout(binding = SSBO_BINDING_CULL_RESULTS, std430) buffer cullResultsSSBO
{
    uint cullResults[];
};

layout(binding = SSBO_BINDING_VISIBLE_INSTANCES, std430) restrict writeonly buffer visibleInstancesSSBO
{
    uint visibleInstances[];
};

bool aabbIntersectsFrustum(AABB aabb, mat4 modelMatrix)
{
    mat3 RS = mat3(modelMatrix);
    mat3 absRS = mat3(abs(RS[0]), abs(RS[1]), abs(RS[2]));

    vec3 worldCenter = vec3(modelMatrix * vec4(aabb.center.xyz, 1.0));
    vec3 worldExtent =  absRS * aabb.extent.xyz;

    for (int i = 0; i < 6; ++i)
    {
        float d = dot(worldCenter, planes[i].xyz);
        float r = dot(worldExtent, abs(planes[i].xyz));

        if (d + r < -planes[i].w)
            return false;
    }

    return true;
}

void main()
{
    if (gl_GlobalInvocationID.x >= maps.length())
        return;

    BufferMap map = maps[gl_GlobalInvocationID.x];
    AABB aabb = AABBs[map.sharedBaseIndex];
    mat4 modelMatrix = matrices[map.matricesIndex];
    uint visibilityBufferBaseIndex = map.visibleInstancesBaseIndex;

    if (!aabbIntersectsFrustum(aabb, modelMatrix))
        return;

    uint counter = atomicAdd(cullResults[map.sharedBaseIndex], 1);
    visibleInstances[visibilityBufferBaseIndex + counter] = map.matricesIndex;        
}