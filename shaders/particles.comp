#version 460 core

#include "binding_points.glsl"
#include "types.glsl"
#include "ubo.glsl"

// Constants
const float gravity = 90.0f;
const float mass = 0.1f;
const float invMass = 1.0 / mass;
const float timeScale = 0.75;
const float blackHolePosScale = 0.33;
const float minLifetimePercent = 0.75;
const float resetVelocityDamper = 0.005;

// Attributes
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SSBOs
layout(binding = SSBO_BINDING_AABB, std430) restrict readonly buffer aabbSSBO
{
    AABB AABBs[];
};

layout(binding = SSBO_BINDING_DRAW_COMMANDS_SOURCE, std430) restrict readonly buffer drawCommandsSourceSSBO
{
    DrawElementsIndirectCommand commands[];
};

layout(binding = SSBO_BINDING_VERTEX_MAP, std430) restrict readonly buffer VertexMapSSBO
{
    VertexMap vertexMap[];
};

// This is the VBO for all gLTF models aliased as vec4s. Avoids having multiple definitions of a 
// vertex and padding issues, since the actual vertex is: Position (vec3), Normal (vec3), tangent (vec4), uv (vec2)
layout(binding = SSBO_BINDING_VBO, std430) buffer VBO
{
    vec4 particles[];
};

// Stripped down mirror of main VBO for shadow pass. Position (vec4), uv (vec2)
layout(binding = SSBO_BINDING_SHADOW_VBO, std430) restrict writeonly buffer shadowVBO
{
    vec2 shadowVertices[];
};

// AABBs for particles are already in world space
void main()
{
    uint id = gl_GlobalInvocationID.x;

    if (id >= vertexMap.length())
        return;
    
    VertexMap map = vertexMap[id];
    AABB aabb = AABBs[map.sharedIndex];

    // Multiply by 3 to convert a vertex struct index (48 bytes) into vec4s
    uint particleIndex = map.vboIndex * 3;
    
    // Position xyz and velocity x
    vec4 d0 = particles[particleIndex];

    // Velocity yz and color rg
    vec4 d1 = particles[particleIndex + 1];

    // Color ba and flags xy
    vec4 d2 = particles[particleIndex + 2];

    // Extract from vec4s
    vec3 position = d0.xyz;
    vec3 velocity = vec3(d0.w, d1.xy);
    vec4 color = vec4(d1.zw, d2.xy);
    vec2 lifetimes = d2.zw;

    vec3 blackHolePos = aabb.center.xyz + aabb.extent.xyz * blackHolePosScale;
    vec3 originalBlackHolePos = blackHolePos;
    blackHolePos.y = aabb.center.y;

    // Move black holes around
    blackHolePos.x += sin(time);
    blackHolePos.z += cos(time);
    blackHolePos.y += sin(time) * 2.0;
    
    // Force from first black hole
    vec3 toBlackHole = blackHolePos - position;
    float dist = length(toBlackHole);
    vec3 force = (gravity / (dist * dist)) * normalize(toBlackHole);

    // Ending condtions
    float innerRadius = min(aabb.extent.x, min(aabb.extent.y, aabb.extent.z));
    
    float decay = dist / innerRadius;
    lifetimes.y -= decay * deltaTime * timeScale;

    if (distance(position, aabb.center.xyz) > innerRadius || lifetimes.y <= 0)
    {   
        // Vary the respawn point
        originalBlackHolePos.y -= sin(time);

        //Kill off most of the original velocity, leave some for variation
        vec3 newVel = velocity * resetVelocityDamper;

        vec3 respawnDir = normalize(aabb.center.xyz - originalBlackHolePos);
        vec3 resetPos = aabb.center.xyz + respawnDir * innerRadius * 0.80;

        particles[particleIndex] = vec4(resetPos, newVel.x);
        particles[particleIndex + 1] = vec4(newVel.yz, color.rg);
        particles[particleIndex + 2] = vec4(color.ba, lifetimes.xx);
        
        shadowVertices[particleIndex] = vec2(resetPos.xy);
        shadowVertices[particleIndex + 1] = vec2(resetPos.z, 1.0);
    }
    else
    { 
        float dt = deltaTime * timeScale;

        vec3 a = force * invMass;
        vec3 v = velocity + a * dt;
        vec3 p = position + v * dt;
        
        particles[particleIndex] = vec4(p, v.x);
        particles[particleIndex + 1] = vec4(v.yz, color.rg);
        particles[particleIndex + 2] = vec4(color.ba, lifetimes);
        
        shadowVertices[particleIndex] = vec2(p.xy);
        shadowVertices[particleIndex + 1] = vec2(p.z, 1.0);
    }
}