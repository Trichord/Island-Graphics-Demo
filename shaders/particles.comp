#version 460 core

// Types
struct DrawElementsIndirectCommand
{
    uint count;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint baseInstance;
};

struct BufferMap
{
    uint matricesIndex;
    uint sharedBaseIndex;
    uint drawBucket;
    uint drawCommandsBaseIndex;
    uint visibleInstancesBaseIndex;
};

struct Particle
{
    vec4 position;
    vec4 velocity;
    vec4 color;
    vec2 flags;
};

struct AABB
{
    vec4 center;
    vec4 extent;
};

// Constants
const float gravity = 15.0f;
const float mass = 0.1f;
const float invMass = 1.0 / mass;
const float scaleParticleSpeed = 0.75;
const float scaleBlackHolePos = 0.33;
const float scaleLifetime = 0.000025;

// Attributes
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// UBOs
layout (std140, binding = 0) uniform cameraData 
{
	layout (offset = 0) mat4 viewMatrix;
	layout (offset = 64) mat4 projectionMatrix;
	layout (offset = 128) mat4 projectionViewMatrix;
	layout (offset = 192) mat4 inverseViewProjectMatrix;
	layout (offset = 256) vec4 cameraPosition;
	layout (offset = 272) float time;
};

layout(binding = 1, std140) uniform frustumPlanes
{
    vec4 planes[6];
};

// SSBOs
layout(binding = 0, std430) restrict readonly buffer mapSSBO
{
    BufferMap maps[];
};

layout(binding = 1, std430) restrict readonly buffer aabbSSBO
{
    AABB AABBs[];
};

layout(binding = 2, std430) restrict readonly buffer matricesSSBO 
{
    mat4 matrices[];
};

layout(binding = 8, std430) restrict readonly buffer drawCommandsSourceSSBO
{
    DrawElementsIndirectCommand commands[];
};

// This is the VBO for all gLTF models aliased as vec4s. Avoids having multiple definitions of a 
// vertex and padding issues, since the actual vertex is: Position (vec3), Normal (vec3), tangent (vec4), tex (vec2)
layout(binding = 9, std430) buffer VBO
{
    vec4 particles[];
};

// In
uniform uint mapIndex;
uniform uint sharedBufferIndex;
uniform uint numParticles;
uniform float deltaTime;

void main()
{
    uint id = gl_GlobalInvocationID.x;

    if (id >= numParticles)
        return;
    
    AABB aabb = AABBs[sharedBufferIndex];
    BufferMap map = maps[mapIndex];
    
    mat4 modelMatrix = matrices[map.matricesIndex];

    // Base vertex is from the vertex struct, which is 48 bytes. 3 * vec4s gets us the right offset
    uint particleIndex = (uint(commands[sharedBufferIndex].baseVertex) + id) * 3;
    
    // Position xyz and velocity x
    vec4 d0 = particles[particleIndex];

    // Velocity yz and color rg
    vec4 d1 = particles[particleIndex + 1];

    // Color ba and flags xy
    vec4 d2 = particles[particleIndex + 2];

    // Extract from vec4s
    vec3 position = d0.xyz;
    vec3 velocity = vec3(d0.w, d1.xy);
    vec4 color = vec4(d1.zw, d2.xy);
    vec2 lifetimes = d2.zw;
    mat3 RS = mat3(modelMatrix);
    mat3 absRS = mat3(abs(RS[0]), abs(RS[1]), abs(RS[2]));

    // World positions
    vec3 worldPos = vec3(modelMatrix * vec4(position, 1.0));
    vec3 worldAABBCenter = vec3(modelMatrix * vec4(aabb.center.xyz, 1.0));
    vec3 worldExtent =  absRS * aabb.extent.xyz;
    vec3 worldPosBH = worldAABBCenter + worldExtent * scaleBlackHolePos;
    vec3 worldPosBH2 = -worldPosBH;

    // Move black holes around
    worldPosBH.x += sin(time);
    worldPosBH.z += cos(time);
    worldPosBH2.x -= sin(time);
    worldPosBH2.z -= cos(time);

    // Force from first black hole
    vec3 d = worldPosBH - worldPos;
    float dist1 = length(d);
    vec3 force = (gravity / dist1) * normalize(d);

    // Force from second black hole
    d = worldPosBH2 - worldPos;
    float dist2 = length(d);
    force += (gravity / dist2) * normalize(d);

    // Ending condtions
    float maxDist = length(worldExtent);
    
    float decay = min(dist1, dist2);
    lifetimes.y -= decay * scaleLifetime * deltaTime;

    if (distance(worldPos, worldAABBCenter) > maxDist || lifetimes.y <= 0)
    {
        particles[particleIndex] = vec4(aabb.center.xyz, 0.0);
        particles[particleIndex + 1] = vec4(0.0, 0.0, color.rg);
        particles[particleIndex + 2] = vec4(color.ba, lifetimes.x, lifetimes.x);
    }
    else
    { 
        float dt = deltaTime * scaleParticleSpeed;

        vec3 worldVel = RS * velocity.xyz;
        vec3 a = force * invMass;
        vec3 v = worldVel + a * dt;
        vec3 p = worldPos + worldVel * dt + 0.5 * a * dt * dt;
        
        vec3 translation = modelMatrix[3].xyz;
        mat3 invRS = inverse(RS);

        vec3 newPos =  invRS * (p - translation);
        vec3 newVel = invRS * v;

        particles[particleIndex] = vec4(newPos, newVel.x);
        particles[particleIndex + 1] = vec4(newVel.yz, color.rg);
        particles[particleIndex + 2] = vec4(color.ba, 1.0, lifetimes);
    }
}